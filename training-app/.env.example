# アクセス保護（公開時は推奨。記録共有を使う場合は必須）。
# 設定すると全画面にパスワードが必要になります。未設定なら保護なし（自宅 LAN など閉じた環境向け）。
APP_PASSWORD=

# 記録共有の保存先（任意）。どちらも未設定なら共有機能はオフになります。
# Vercel で Upstash Redis（無料プラン）を接続すると、以下のどちらかの組が自動で設定されます。
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# 自宅 PC などで `npm start` する場合は、ファイルに保存できます（Vercel では使えません）。
# SHARE_STORE=file
# SHARE_FILE=.data/share.json
